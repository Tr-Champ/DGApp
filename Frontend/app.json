{
  "expo": {
    "name": "UMUHUZA",
    "slug": "umuhuza",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/DGLoGo.jpg",
    "scheme": "umuhuza",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/DGLoGo.jpg",
      "bundleIdentifier": "com.dgretail.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.dgretail.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/DGLoGo.jpg",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/DGLoGo.jpg"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/DGLoGo.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/DGLoGo.jpg",
          "imageWidth": 160
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5b71dac4-0402-4489-a389-2b9bd115de6d"
      }
    }
  }
}